	(text "15V -> 5V BUCK (2A)"
		(exclude_from_sim no)
		(at 182.88 17.78 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left top)
		)
		(uuid "10e9c9fe-fd5c-432a-adbb-d73bfd8845b8")
	)
	(text "TVS standoff 18V > 15V +5%.\nClamps a faulty source; the polyfuse\nopens on sustained overcurrent."
		(exclude_from_sim no)
		(at 17.78 114.3 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "160d6143-521c-4875-a81a-f5b91ddba6ab")
	)
	(text "ESD on D+/D-. USBLC6 VBUS pin goes to +5V, NOT 15V VBUS (6V max).\nUSB_DP/USB_DN go to the ESP32-S3 native USB (GPIO19/20)."
		(exclude_from_sim no)
		(at 17.78 167.64 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "2766e32d-fb72-40e9-9d15-342f2579cc55")
	)
	(text "Values per AP63205 datasheet Table 3. Inductor Isat >= 3A, DCR < 100mOhm\n(e.g. Bourns SRN6045TA-4R7M). EN tied to VIN = always on."
		(exclude_from_sim no)
		(at 182.88 99.06 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "5014c5bf-fdb8-4e15-8c89-3d8c00ce347d")
	)
	(text "Single-resistor config: R101 = 56k on CFG1 -> request 15V\n(6.8k = 9V, 24k = 12V, 120k = 20V). Use 1% parts.\nVHV and VBUS are 32V-tolerant and go straight to VBUS; C101 is the 1uF VHV cap.\nCFG2/SCL and CFG3/SDA float (internal pull-ups). They are also I2C (addr 0x22)\nif the ESP32 should read PD status / available current later.\nDP/DM left open so the USB data lines pass straight to the ESP32.\nPD_PG is open-drain, LOW = 15V negotiated. Keep the TMC2209 disabled\nuntil PD_PG is low; with a non-PD or <27W charger VBUS stays at 5V."
		(exclude_from_sim no)
		(at 96.52 114.3 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "57d4616d-51fe-4af1-95c2-b0eb2cc79b4d")
	)
	(text "USB PD SINK - requests 15V"
		(exclude_from_sim no)
		(at 96.52 17.78 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left top)
		)
		(uuid "5c8d2dea-9869-43f2-9d8c-46988d41cca5")
	)
	(text "5V -> 3.3V LDO"
		(exclude_from_sim no)
		(at 182.88 111.76 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left top)
		)
		(uuid "988db572-c263-4166-a6cc-cf05e8d2b387")
	)
	(text "USB-C INPUT + PROTECTION"
		(exclude_from_sim no)
		(at 17.78 17.78 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left top)
		)
		(uuid "eab07151-cb9b-4f7f-b920-037f5db23471")
	)
	(text "AMS1117 needs >= 22uF on\nthe output for stability.\nESP32 peaks ~500mA:\n1.7V x 0.5A = 0.85W in\nSOT-223, give the tab copper."
		(exclude_from_sim no)
		(at 231.14 119.38 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "fc54a6e8-d839-4072-9c89-df82ac30ac1c")
	)
