	(text "USB_DP/USB_DN = native USB on GPIO19/20 (flash + CDC serial,\nno USB-UART bridge needed). ESD is on the power sheet.\nTMC2209 UART: GPIO17 (TX) via R9 1k, GPIO18 (RX) direct;\ndriver address 0 (MS1/MS2 tied low on the root).\nAvoid GPIO35-37 on octal-PSRAM modules (N8R8 etc.),\nand the strapping pins GPIO0/3/45/46 for new I/O."
		(exclude_from_sim no)
		(at 167.64 93.98 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "173026c4-1663-4b48-9eb7-dd81abc81009")
	)
