* text=auto

# KiCad sources are plain text and diff well
*.kicad_pro text
*.kicad_sch text
*.kicad_pcb text
*.kicad_sym text
*.kicad_mod text

# CAD / 3D files are binary (FCStd is a zip archive)
*.FCStd binary
*.step  binary
*.stp   binary
*.stl   binary
*.3mf   binary

# Images and documents
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
